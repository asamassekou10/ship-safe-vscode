{
  "name": "ship-safe",
  "displayName": "Ship Safe — Security Scanner",
  "description": "Real-time security scanning with 23 AI agents. Find leaked secrets, prompt injections, MCP misconfigs, and CVEs as you code.",
  "version": "0.1.0",
  "publisher": "ship-safe",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/asamassekou10/ship-safe-vscode"
  },
  "homepage": "https://www.shipsafecli.com",
  "bugs": {
    "url": "https://github.com/asamassekou10/ship-safe-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "secrets",
    "vulnerability",
    "scanner",
    "ai",
    "owasp"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shipSafe.scanWorkspace",
        "title": "Ship Safe: Scan Workspace"
      },
      {
        "command": "shipSafe.scanFile",
        "title": "Ship Safe: Scan Current File"
      },
      {
        "command": "shipSafe.showReport",
        "title": "Ship Safe: Show Report"
      },
      {
        "command": "shipSafe.toggleWatch",
        "title": "Ship Safe: Toggle Watch Mode"
      }
    ],
    "configuration": {
      "title": "Ship Safe",
      "properties": {
        "shipSafe.autoScanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan files when saved"
        },
        "shipSafe.severity": {
          "type": "string",
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "description": "Minimum severity to show in diagnostics"
        },
        "shipSafe.showInlineHints": {
          "type": "boolean",
          "default": true,
          "description": "Show inline hints for findings"
        },
        "shipSafe.deep": {
          "type": "boolean",
          "default": false,
          "description": "Enable AI deep analysis (requires API key)"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "shipSafe.scanFile",
          "group": "shipSafe"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "rimraf dist && npm run check && node esbuild.config.mjs --production",
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "check": "tsc --noEmit -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.3.0"
  }
}
